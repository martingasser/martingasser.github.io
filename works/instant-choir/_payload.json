[{"data":1,"prerenderedAt":84},["ShallowReactive",2],{"work-\u002Fworks\u002Finstant-choir":3},{"id":4,"title":5,"body":6,"collaborators":65,"description":66,"extension":67,"img":68,"meta":69,"navigation":31,"path":70,"roles":65,"seo":71,"stem":72,"tags":73,"type":81,"url":65,"year":82,"__hash__":83},"works\u002Fworks\u002Finstant-choir.md","Instant Choir",{"type":7,"value":8,"toc":61},"minimark",[9,13,16,32,35],[10,11,12],"p",{},"Instant Choir is a participative performance, involving audience members as protagonists who are controlled by a smartphone app. It touches critical issues such as the manipulative power of technology, its effects on interpersonal communication and behavior, and the addictive potential of Social Media and recommender systems.",[10,14,15],{},"I developed smartphone apps (Android & iOS) and built a Max\u002FMSP-based system for controlling stage visuals, audio, and smartphone apps from an on-stage iPad.",[17,18,21],"div",{"className":19},[20],"video-container",[22,23],"iframe",{"className":24,"width":26,"height":27,"src":28,"frameBorder":29,"allow":30,"allowFullScreen":31},[25],"video","100%",600,"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FD0lvkT1ewrc","0","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",true,[10,33,34],{},"collaborators:",[36,37,38,42,51,58],"ul",{},[39,40,41],"li",{},"Mimu Merz",[39,43,44],{},[45,46,50],"a",{"href":47,"rel":48},"http:\u002F\u002Fwww.cquence.at\u002F",[49],"nofollow","C'quence",[39,52,53],{},[45,54,57],{"href":55,"rel":56},"https:\u002F\u002Fmedienmanufaktur.com\u002Fmusikerinnen\u002Flukaslauermann-2\u002F",[49],"Lukas Lauermann",[39,59,60],{},"Markus Zahradnik",{"title":62,"searchDepth":63,"depth":63,"links":64},"",2,[],null,"Interactive theatre performance","md","\u002Fworks\u002Fmedia\u002Finstant-choir.jpg",{},"\u002Fworks\u002Finstant-choir",{"title":5,"description":66},"works\u002Finstant-choir",[74,75,76,77,78,79,80],"theatre","performance","art","sou