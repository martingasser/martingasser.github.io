[{"data":1,"prerenderedAt":118},["ShallowReactive",2],{"work-\u002Fworks\u002Fco-corporeality-2":3},{"id":4,"title":5,"body":6,"collaborators":103,"description":104,"extension":105,"img":106,"meta":107,"navigation":68,"path":108,"roles":103,"seo":109,"stem":110,"tags":111,"type":115,"url":103,"year":116,"__hash__":117},"works\u002Fworks\u002Fco-corporeality-2.md","Co-Corporeality@Angewandte Festival 2021",{"type":7,"value":8,"toc":99},"minimark",[9,45,54,69,72],[10,11,12,13,20,21,26,27,32,33,38,39,44],"p",{},"For the ",[14,15,19],"a",{"href":16,"rel":17},"https:\u002F\u002Fcocorporeality.net\u002F",[18],"nofollow","Co-Corporeality"," artistic research project, we have developed a mobile eye tracking solution. It consists of a ",[14,22,25],{"href":23,"rel":24},"https:\u002F\u002Fpupil-labs.com\u002F",[18],"Pupil Labs"," eye camera, an ",[14,28,31],{"href":29,"rel":30},"https:\u002F\u002Fwww.intelrealsense.com\u002Ftracking-camera-t265\u002F",[18],"Intel Realsense T265"," tracking camera, and an ",[14,34,37],{"href":35,"rel":36},"https:\u002F\u002Fwww.intelrealsense.com\u002Fdepth-camera-d435\u002F",[18],"Intel Realsense D435"," world camera, mounted on a bike helmet. A ",[14,40,43],{"href":41,"rel":42},"https:\u002F\u002Fwww.raspberrypi.org\u002Fproducts\u002Fraspberry-pi-4-model-b\u002F",[18],"Raspberry Pi 4"," is used to compress and transmit the image data over Ethernet to another computer where a combination of the Pupil Labs software and custom software components is used to determine the exact position and gaze direction of a viewer in space. This information can be subsequently used to detect which objects a person currently looks at.",[10,46,47,48,53],{},"Watch our presentation video which has been shown at ",[14,49,52],{"href":50,"rel":51},"https:\u002F\u002Fangewandtefestival.at\u002F",[18],"Angewandte Festival 2021",":",[55,56,59,60],"div",{"className":57},[58],"video-container","\n    ",[61,62],"iframe",{"src":63,"className":64,"frameBorder":66,"allow":67